{
  "name": "Flowday — Personal Workflow & Tasks",
  "short_name": "Flowday",
  "description": "Goals, projects, processes, tasks, and habits in one calm, offline-first app with cloud sync.",
  "id": "./",
  "start_url": "./#/life/today",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#f7f8fc",
  "theme_color": "#4f46e5",
  "categories": ["productivity", "lifestyle"],
  "icons": [
    { "src": "./icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "./icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "./apple-touch-icon.png", "sizes": "180x180", "type": "image/png", "purpose": "any" },
    { "src": "./icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "./icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add a task",
      "short_name": "Add task",
      "url": "./#/life/today?quickadd=task",
      "description": "Capture a task in seconds"
    },
    {
      "name": "Life Flow",
      "short_name": "Life",
      "url": "./#/life/today",
      "description": "Your daily flow: tasks, habits, goals"
    },
    {
      "name": "POS",
      "short_name": "POS",
      "url": "./#/business/pos",
      "description": "Open the point of sale"
    }
  ]
}
